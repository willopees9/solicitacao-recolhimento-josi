# Supabase public project URL.
# Use the staging project values for staging deploys and production values for production deploys.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key.
# This key is safe for browser use, but should still be configured per environment.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key.
# Server-only secret. Never expose this value in client code and never commit the real key.
SUPABASE_SERVICE_ROLE_KEY=

# Temporary signed URL lifetime for private evidence files, in seconds.
SIGNED_URL_EXPIRY_SECONDS=900
